// 5. Crea una función que reciba un número y devuelva true si es primo, y false en caso contrario

function elPrimo(numero) {
    if (numero <= 1) {
        return false;
    }

    for (let i = 2; i < numero; i++) {
        if (numero % i === 0) {
            return false;
        }
    }

    return true;
}

console.log(elPrimo(7));
console.log(elPrimo(4));
console.log(elPrimo(1));

// 6. Crea una función que reciba dos arrays y devuelva un nuevo array que contenga los elementos comunes entre ambos

function elementosComunes(array1, array2) {
    return array1.filter(numerobusqueda => array2.includes(numerobusqueda));
}

const lista1 = [1, 2, 3];
const lista2 = [3, 4, 5];

console.log(elementosComunes(lista1, lista2));

// 7. Crea una función que reciba un array de números y devuelva la suma de todos los números pares

function sumaPares(array2) {
    let suma = 0;

    array2.forEach(numero => { if (numero % 2 == 0) { suma += numero; } });
    return suma;
}

console.log(sumaPares([1, 2, 3, 4, 5, 6]))

// 8. Crea una función que reciba un array de números y devuelva un nuevo array con cada número elevado al cuadrado

function Cuadrado(array3) {
    let newarray3 = [];

    array3.forEach(siete => { let resultado = siete * siete; newarray3.push(resultado) });

    return newarray3;
}

console.log(Cuadrado([1, 2, 3]));


