// 10. Crea una función que calcule el factorial de un número dado

function calcularFactorial(numero) {
    if (numero == 0 || numero == 1) {
        return 1;
    }

    let resultado = 1;

    for (let i = 2; i <= numero; i++) {
        resultado *= i;
    }
    return resultado;
}

console.log(calcularFactorial(5));


function ninja(texto) {
    let vocales = 'aeiouAEIOU';

    // 1. .split('') rompe el texto en un array de letras individuales.
    // 2. .filter() se queda solo con las letras que cumplen la condición (si es vocal).
    // 3. .length nos da el total de elementos que sobrevivieron al filtro.
    return texto.split('').filter(letra => vocales.includes(letra)).length;
}

console.log(ninja("fdsahfjdkhefuafb"));



